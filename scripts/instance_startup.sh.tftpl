#!/bin/bash

set -Eeuo pipefail
set +x 2>/dev/null # Disable command tracing just in case

docker network inspect vaultwarden-net >/dev/null 2>&1 || \
    docker network create vaultwarden-net # Create network if it doesn't exist

command -v jq >/dev/null || {
  echo "Required command not found: jq" >&2
  exit 1
}

# Helper functions to retrieve secrets from Secret Manager
get_token() {
  curl -sf -H "Metadata-Flavor: Google" \
    "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" \
    | jq -r '.access_token'
}
get_secret() {
  local name="$1"
  local token
  token=$(get_token)
  [[ -z "$token" || "$token" == "null" ]] && return 1
  curl -sf -H "Authorization: Bearer $${token}" \
    "https://secretmanager.googleapis.com/v1/projects/${gcp_project_id}/secrets/$${name}/versions/latest:access" \
    | jq -r '.payload.data' \
    | base64 -d
}
require_secret() {
  local name="$1"
  local value=""

  for attempt in 1 2 3 4 5; do
    if value="$(get_secret "$name")" && [[ -n "$value" ]]; then
      printf '%s' "$value"
      return 0
    fi

    echo "Secret '$name' unavailable, attempt $attempt/5" >&2
    sleep 5
  done

  echo "Required secret '$name' could not be loaded; aborting startup" >&2
  exit 1
}

vaultwarden_env_args=()
if [[ "${vw_admin_enabled}" == "true" ]]; then
  ADMIN_TOKEN_HASH="$(require_secret admin_token_hash)"
  vaultwarden_env_args+=(-e ADMIN_TOKEN="$${ADMIN_TOKEN_HASH:-}")
fi
VAULT_TUNNEL_TOKEN="$(require_secret vault_tunnel_token)"
BACKUP_PASS="$(require_secret backup_pass)"
R2_KEY_ID="$(require_secret r2_key_id)"
R2_KEY="$(require_secret r2_key)"

DATA_DISK_MOUNT="/var/vaultwarden/data"

docker pull vaultwarden/server@"${vaultwarden_server_container_hash}"
docker pull ttionya/vaultwarden-backup@"${ttionya_vaultwarden_backup_container_hash}"
docker pull cloudflare/cloudflared@${cloudflare_cloudflared_container_hash}

# Setup persistent data disk
DATA_DISK="/dev/disk/by-id/google-${gcp_disk_name}"
mount_persistent_disk() {
  mkdir -p "$DATA_DISK_MOUNT"
  for attempt in 1 2 3 4 5; do
    if [ -b "$DATA_DISK" ]; then
      # Check if disk has a filesystem
      if ! blkid "$DATA_DISK" | grep -q 'TYPE='; then
        echo "Formatting data disk as ext4..." >&2
        mkfs.ext4 -m 0 -F -E lazy_itable_init=0,lazy_journal_init=0,discard "$DATA_DISK"
      fi
      # Mount it if not already mounted
      if ! mountpoint -q "$DATA_DISK_MOUNT"; then
        echo "Mounting data disk..." >&2
        mount -o discard,defaults "$DATA_DISK" "$DATA_DISK_MOUNT"
      fi
      return 0
    fi
    echo "Failed to find the data disk to attach: '$DATA_DISK'. Retry $attempt/5..." >&2
    sleep 3
  done
  echo "ERROR: Data disk not found: $DATA_DISK." >&2
  exit 1
}
mount_persistent_disk
chown -R 1000:1000 "$DATA_DISK_MOUNT" # vaultwarden is run with 1000 user

# Launch Vaultwarden
docker stop vaultwarden 2>/dev/null || true
docker rm -f vaultwarden 2>/dev/null || true
# Add "-e DISABLE_ICON_DOWNLOAD=true \" to disable icons and conserve bandwidth.
docker run -d \
  --name vaultwarden \
  --restart always \
  --network vaultwarden-net \
  -u 1000:1000 \
  -v "$DATA_DISK_MOUNT":/data \
  -e SIGNUPS_ALLOWED=false \
  -e SHOW_PASSWORD_HINT=false \
  -e WEBSOCKET_ENABLED=true \
  -e ICON_SERVICE=internal \
  -e ICON_CACHE_TTL=2592000 \
  "$${vaultwarden_env_args[@]}" \
  vaultwarden/server@"${vaultwarden_server_container_hash}"

# Launch Cloudflare Tunnel (connects to Cloudflare and routes traffic to the Vaultwarden container)
docker stop cloudflared 2>/dev/null || true
docker rm -f cloudflared 2>/dev/null || true
docker run -d \
  --name cloudflared \
  --restart always \
  --network vaultwarden-net \
  -u 1000:1000 \
  cloudflare/cloudflared@${cloudflare_cloudflared_container_hash} tunnel --no-autoupdate run --token "$VAULT_TUNNEL_TOKEN"

# Generate Rclone configuration for the backup container
mkdir -p /var/vaultwarden-backup
if ! mountpoint -q /var/vaultwarden-backup; then
  mount -t tmpfs -o size=1M tmpfs /var/vaultwarden-backup
  echo "Created 1MB tmpfs for backups." >&2
else
  echo "Backup tmpfs is already mounted. Skipping." >&2
fi
touch /var/vaultwarden-backup/rclone.conf
chmod 600 /var/vaultwarden-backup/rclone.conf
cat << EOF > /var/vaultwarden-backup/rclone.conf
[CloudflareR2]
type = s3
provider = Cloudflare
access_key_id = $R2_KEY_ID
secret_access_key = $R2_KEY
region = auto
endpoint = https://${cf_account_id}.r2.cloudflarestorage.com
no_check_bucket = true
acl = private
EOF
chown 1000:1000 /var/vaultwarden-backup/rclone.conf

# Launch the Offsite Backup Engine
docker stop vaultwarden_backup 2>/dev/null || true
docker rm -f vaultwarden_backup 2>/dev/null || true
docker run -d \
  --name vaultwarden_backup \
  --restart always \
  --network vaultwarden-net \
  -u 1000:1000 \
  -v "$DATA_DISK_MOUNT":/data:ro \
  -v /var/vaultwarden-backup/rclone.conf:/config/rclone/rclone.conf:ro \
  -e DATA_DIR="/data" \
  -e RCLONE_REMOTE_NAME="CloudflareR2" \
  -e RCLONE_REMOTE_DIR="/${backup_bucket_name}/" \
  -e CRON="${backup_cron}" \
  -e ZIP_PASSWORD="$BACKUP_PASS" \
  -e BACKUP_KEEP_DAYS="${backup_keep_days}" \
  ttionya/vaultwarden-backup@"${ttionya_vaultwarden_backup_container_hash}"

echo "Downloading the restore_backup.sh script" >&2
restore_script_path="/var/${restore_script_object_name}"
curl -fsS --retry 5 -H "Authorization: Bearer $(get_token)" \
  "https://storage.googleapis.com/storage/v1/b/${restore_script_bucket_name}/o/${restore_script_object_name}?alt=media" \
  -o "$restore_script_path"

sed -i "s|^VAULTWARDEN_BACKUP_CONTAINER_HASH=.*|VAULTWARDEN_BACKUP_CONTAINER_HASH=\"${ttionya_vaultwarden_backup_container_hash}\"|g" "$restore_script_path"
chmod +x "$restore_script_path" # Note: Since the /var mount is noexec, this permission is not directly executable

echo "All done, have a good flight" >&2
